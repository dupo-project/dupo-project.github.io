# Required by deepaction/train_dupo.sh
DATA_DIR=/absolute/path/to/planarena-parquet
BASE_MODEL=Qwen/Qwen2.5-3B-Instruct

# Reward-output parser: qwen or llama
MODEL_FAMILY=qwen

# Training defaults. Override them for your experiment.
N_GPUS=16
ROLLOUT_N=4
TRAIN_BATCH_SIZE=512
VAL_BATCH_SIZE=128
TOOL_WEIGHT=0.7
PLAN_WEIGHT=0.1
SFT_DECAY=0.01
DECAY_RATE=0.5

# Set to 1 to print the resolved command without launching training.
DRY_RUN=1
